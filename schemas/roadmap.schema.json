{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "title", "principles", "phases", "training_blueprints", "starter_weeks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "title": {
      "type": "object",
      "required": ["zh", "en"],
      "additionalProperties": false,
      "properties": {"zh": {"type": "string"}, "en": {"type": "string"}}
    },
    "principles": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "phases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title_zh", "title_en", "week_start", "week_end", "prerequisites", "outcomes", "labs", "english_output", "gate", "weekly_focus"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "title_zh": {"type": "string"},
          "title_en": {"type": "string"},
          "week_start": {"type": "integer", "minimum": 1, "maximum": 78},
          "week_end": {"type": "integer", "minimum": 1, "maximum": 78},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "outcomes": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "labs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "english_output": {"type": "string"},
          "gate": {"type": "string"},
          "weekly_focus": {
            "type": "array",
            "minItems": 13,
            "maxItems": 13,
            "items": {
              "type": "object",
              "required": ["week", "title_zh", "title_en"],
              "additionalProperties": false,
              "properties": {
                "week": {"type": "integer", "minimum": 1, "maximum": 78},
                "title_zh": {"type": "string"},
                "title_en": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "training_blueprints": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 5}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 6}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 7}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 8}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 9}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 10}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 11}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 12}}}]},
        {"allOf": [{"$ref": "#/$defs/trainingBlueprint"}, {"properties": {"week": {"const": 13}}}]}
      ],
      "items": false
    },
    "starter_weeks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["week", "missions"],
        "additionalProperties": false,
        "properties": {
          "week": {"type": "integer", "minimum": 1, "maximum": 4},
          "missions": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["codename", "scenario", "objective", "lab", "english_output"],
              "additionalProperties": false,
              "properties": {
                "codename": {"type": "string", "minLength": 1},
                "scenario": {"type": "string", "minLength": 1},
                "objective": {"type": "string", "minLength": 1},
                "lab": {"type": "string", "minLength": 1},
                "english_output": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "seedFiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/nonEmptyString"},
      "propertyNames": {
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)(?!private(?:/|$))(?!\\.git(?:/|$))(?!.*(?:/private|/\\.git)(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "trainingProject": {
      "type": "object",
      "required": ["id", "goal", "environment", "starting_state", "seed_files", "acceptance_criteria", "safety_boundaries", "core_concepts", "friday_variation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
        "goal": {"$ref": "#/$defs/nonEmptyString"},
        "environment": {"$ref": "#/$defs/nonEmptyString"},
        "starting_state": {"$ref": "#/$defs/nonEmptyString"},
        "seed_files": {"$ref": "#/$defs/seedFiles"},
        "acceptance_criteria": {"$ref": "#/$defs/nonEmptyStringArray"},
        "safety_boundaries": {"$ref": "#/$defs/nonEmptyStringArray"},
        "core_concepts": {"$ref": "#/$defs/nonEmptyStringArray"},
        "friday_variation": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "trainingMission": {
      "type": "object",
      "required": ["codename", "scenario", "learning_goal", "concept_prompt", "guided_practice", "independent_delivery"],
      "additionalProperties": false,
      "properties": {
        "codename": {"$ref": "#/$defs/nonEmptyString"},
        "scenario": {"$ref": "#/$defs/nonEmptyString"},
        "learning_goal": {"$ref": "#/$defs/nonEmptyString"},
        "concept_prompt": {"$ref": "#/$defs/nonEmptyString"},
        "guided_practice": {"$ref": "#/$defs/nonEmptyString"},
        "independent_delivery": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "trainingBlueprint": {
      "type": "object",
      "required": ["week", "project", "missions"],
      "additionalProperties": false,
      "properties": {
        "week": {"type": "integer", "minimum": 5, "maximum": 13},
        "project": {"$ref": "#/$defs/trainingProject"},
        "missions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/trainingMission"}
        }
      }
    }
  }
}
